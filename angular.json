{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "ggokiorder": {
      "projectType": "library",
      "root": "projects/ggokiorder",
      "sourceRoot": "projects/ggokiorder/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/ggokiorder/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/ggokiorder/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/ggokiorder/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "tsConfig": "projects/ggokiorder/tsconfig.spec.json",
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ]
          }
        }
      }
    }
  },
  "cli": {
    "analytics": "2b0b0d8a-616d-4221-b7f1-d08c929c7df2"
  }
}
