{
  "name": "ggokiorder",
  "version": "1.0.1",
  "private": true,
  "files": [
    "dist/ggokiorder"
  ],
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:lib": "ng build ggokiorder && npm run postbuild:lib",
    "postbuild:lib": "node -e \"require('fs').rmSync('dist/ggokiorder/.npmignore',{force:true})\"",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "pack:lib": "npm run build:lib && npm pack ./dist/ggokiorder"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.20",
    "@angular/cli": "^19.2.27",
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/compiler-cli": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@angular/router": "^19.2.0",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^19.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "typescript": "~5.7.2",
    "zone.js": "~0.15.0"
  }
}
